pragma language_version >= 0.18;

import CompactStandardLibrary;

// ------------------------------------------------------
// Data Structures
// ------------------------------------------------------
struct Sicky_Record {
    id: Uint<64>,
    doctor: ZswapCoinPublicKey, // doctors[doctor] must be true
    issued_at: Uint<64>,
    duration_of_certificate: Uint<64>, // probably days
    patient_name: Bytes<128>, // HIDEABLE
    condition: Bytes<128>, // HIDEABLE
    treatment: Bytes<128>, // HIDEABLE
}

// this is the admin account that can add doctors to the doctors mapping
export ledger doctor_register: ZswapCoinPublicKey;

// the doctor register can add doctors to the register
export ledger doctors: Map<ZswapCoinPublicKey, Boolean>;

// the client records
// TODO this is currently only 1 per client
// client --> hash(sicky_record)
export ledger client_records: Map<ZswapCoinPublicKey, Bytes<32>>;

// client --> disclosed fields
export ledger client_disclosed: Map<ZswapCoinPublicKey, Sicky_Record>;

// ------------------------------------------------------
// Constructor
// ------------------------------------------------------
constructor() {
  doctor_register = ownPublicKey();
}

// ------------------------------------------------------
// UTILS
// ------------------------------------------------------
export circuit sicky_record_hash(sicky: Sicky_Record): Bytes<32> {
    return persistentHash<Sicky_Record>(sicky);
}

// ------------------------------------------------------
// DOCTOR REGISTER METHODS
// ------------------------------------------------------
export circuit add_doctor(doctor: ZswapCoinPublicKey): [] {
    assert(ownPublicKey() == doctor_register, "Only Register can call");
    doctors.insert(disclose(doctor), true);
}

export circuit remove_doctor(doctor: ZswapCoinPublicKey): [] {
    assert(ownPublicKey() == doctor_register, "Only Register can call");
    doctors.insert(disclose(doctor), false);
}

// ------------------------------------------------------
// DOCTOR METHODS
// ------------------------------------------------------
export circuit create_client_record(
    id: Uint<64>,
    issued_at: Uint<64>,
    duration_of_certificate: Uint<64>, // probably days
    client: ZswapCoinPublicKey,
    patient_name: Bytes<128>,
    condition: Bytes<128>,
    treatment: Bytes<128>,
): [] {
    const doctor = ownPublicKey();
    assert(doctors.lookup(doctor), "only doctors can create records");

    const record = Sicky_Record {
        id,
        doctor,
        issued_at,
        duration_of_certificate,
        patient_name,
        condition,
        treatment,
    };

    const hash = disclose(sicky_record_hash(record));

    client_records.insert(disclose(client), hash);
}

// ------------------------------------------------------
// CLIENT METHODS
// ------------------------------------------------------
export circuit client_disclose(
    id: Uint<64>,
    issued_at: Uint<64>,
    duration_of_certificate: Uint<64>, // probably days
    doctor: ZswapCoinPublicKey,
    patient_name: Bytes<128>, // HIDEABLE
    condition: Bytes<128>, // HIDEABLE
    treatment: Bytes<128>, // HIDEABLE
    disclose_fields: [Boolean, Boolean, Boolean]
): [] {
    const client = ownPublicKey();

    const record = Sicky_Record {
        id,
        doctor,
        issued_at,
        duration_of_certificate,
        patient_name,
        condition,
        treatment,
    };

    const hash = disclose(sicky_record_hash(record));

    const lookUpHash = client_records.lookup(client);

    assert(hash == lookUpHash, "Hashes don't match");

    // const empty = convertFieldToBytes(32, 0, "");

    // const pn = disclose_fields[0] ? some<Opaque<"string">>(patient_name) : empty;
    // const c = disclose_fields[1] ? some<Opaque<"string">>(condition) : empty;
    // const t = disclose_fields[2] ? some<Opaque<"string">>(treatment) : empty;

    // const disclosed_record = Sicky_Record {
    //     id,
    //     doctor,
    //     issued_at,
    //     duration_of_certificate,
    //     patient_name: pn,
    //     condition: c,
    //     treatment: t,
    // };

    // // insert public record
    // client_disclosed.insert(disclose(client), disclose(disclosed_record));
}